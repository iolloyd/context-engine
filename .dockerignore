# Keep the build context small. Anything not required to install the
# package belongs here. Mirror most of .gitignore plus a few extras.

# Python build artefacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Local virtualenvs
.venv/
venv/
env/

# Test + tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/
fixtures/

# Local databases (sqlite is for dev; production uses Postgres)
*.db
*.db-journal
*.sqlite

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Repo metadata not needed inside the image
.git/
.github/
.gitignore
docs/
*.md
LICENSE
Dockerfile
.dockerignore
